# --- Database (required) ---
# MySQL / TiDB connection string used by Drizzle ORM.
DATABASE_URL="mysql://setugov:setugov@127.0.0.1:3307/setugov"

# --- Server ---
NODE_ENV="development"
PORT="3000"
# Secret used to sign / verify the session cookie.
JWT_SECRET="dev-only-insecure-secret-change-me"
# openId of the account that should be treated as platform administrator.
OWNER_OPEN_ID="dev-admin"

# --- Demo deployment only ---
# "1" re-enables the /api/auth/dev role picker even when NODE_ENV=production.
# Only for a hosted demo that holds seeded sample data — never with real data.
# Set BOTH (VITE_ prefix is baked into the client bundle at build time).
DEMO_AUTH="0"
VITE_DEMO_AUTH="0"

# --- Manus OAuth portal (leave blank for local dev; dev sign-in is used instead) ---
OAUTH_SERVER_URL=""
VITE_APP_ID="setugov-local"
VITE_OAUTH_PORTAL_URL=""

# --- Object storage (optional; document vault uploads) ---
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
VITE_FRONTEND_FORGE_API_URL=""
VITE_FRONTEND_FORGE_API_KEY=""

# --- SetuGov Assistant (chatbot) ---
# Used only when BUILT_IN_FORGE_API_KEY above is blank. Set ONE of these
# (Anthropic is tried first if both are set); leave both blank to keep the
# assistant disabled (it will say so in the UI, not crash).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
