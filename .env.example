# --- Database (required) ---
# MySQL / TiDB connection string used by Drizzle ORM.
DATABASE_URL="mysql://setugov:setugov@127.0.0.1:3307/setugov"

# --- Server ---
NODE_ENV="development"
PORT="3000"
# Secret used to sign / verify the session cookie.
JWT_SECRET="dev-only-insecure-secret-change-me"
# openId of the account that should be treated as platform administrator.
OWNER_OPEN_ID="dev-admin"

# --- Manus OAuth portal (leave blank for local dev; dev sign-in is used instead) ---
OAUTH_SERVER_URL=""
VITE_APP_ID="setugov-local"
VITE_OAUTH_PORTAL_URL=""

# --- Object storage (optional; document vault uploads) ---
BUILT_IN_FORGE_API_URL=""
BUILT_IN_FORGE_API_KEY=""
VITE_FRONTEND_FORGE_API_URL=""
VITE_FRONTEND_FORGE_API_KEY=""
